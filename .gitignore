# Published tree gitignore — installed as .gitignore by publish.sh.
# The public repo is built by publish.sh; these are backstops for anything
# that is created while running or testing in the published directory.

# Bytecode
__pycache__/
*.py[cod]
*$py.class

# FreeCAD transient files
*.FCBak
*.FCStd1
Fields.FCStd.lock
DirectModeling.FCStd.lock

# Test runner / IDE output
.pytest_cache/
.coverage
htmlcov/
.idea/
.vscode/

# Never ship dev-only material if a developer creates it in-place
tests/
private/
